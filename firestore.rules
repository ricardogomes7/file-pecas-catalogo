rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function active() {
      return signed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function validProduct() {
      return request.resource.data.keys().hasAll(['name','vehicle','application','sku','price','photoUrl','quantity','floor','sector','side','height','updatedAt','updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.vehicle is string
        && request.resource.data.application is string
        && request.resource.data.sku is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.photoUrl is string
        && request.resource.data.floor in ['1','2']
        && request.resource.data.sector is string
        && request.resource.data.side in ['Esquerdo','Direito','Frente']
        && request.resource.data.height in ['Baixo','Médio','Alto']
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /users/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /products/{id} {
      allow read: if active();
      allow create, update: if active() && validProduct();
      allow delete: if active();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
